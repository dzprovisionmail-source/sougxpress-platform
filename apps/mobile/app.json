{
  "expo": {
    "name": "Soug-XPRESS",
    "slug": "sougxpress-founder-os",
    "scheme": "sougxpress",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eb7659b4-30d9-4522-a73b-a507a87b4a70"
    },
    "orientation": "portrait",
    "icon": "./assets/brand/sougxpress-app-icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "eb7659b4-30d9-4522-a73b-a507a87b4a70"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-official-soug-xpress.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A1B33"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notifications/soug_xpress_notification_small_icon.png",
          "color": "#FF8A00",
          "sounds": [
            "./assets/notifications/market_message.wav",
            "./assets/notifications/market_order.wav",
            "./assets/notifications/market_success.wav",
            "./assets/notifications/market_alert.wav"
          ]
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.sougxpress.founder",
      "associatedDomains": [
        "applinks:sougxpress.dz"
      ]
    },
    "android": {
      "package": "com.sougxpress.founder",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/sougxpress-app-icon.png",
        "backgroundColor": "#0A1B33"
      },
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sougxpress.dz",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "sougxpress",
              "host": "auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    }
  }
}
