{
    "expo": {
    "name": "SougXpress Founder OS",
    "slug": "sougxpress-founder-os",
    "scheme": "sougxpress",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eb7659b4-30d9-4522-a73b-a507a87b4a70"
    },
    "orientation": "portrait",
    "icon": "./assets/brand/logo-app-icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "eb7659b4-30d9-4522-a73b-a507a87b4a70"
      }
    },
    "splash": {
      "image": "./assets/brand/logo-official-soug-xpress.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1B33"
    },
    "notification": {
      "icon": "./assets/brand/icon.png",
      "iosDisplayInForeground": true,
      "color": "#FF8A00"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/icon.png",
          "color": "#FF8A00",
          "sounds": []
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.sougxpress.founder",
      "associatedDomains": [
        "applinks:sougxpress.dz"
      ]
    },
    "android": {
      "package": "com.sougxpress.founder",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/logo-app-icon.png",
        "backgroundColor": "#FF8A00"
      },
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sougxpress.dz",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "sougxpress",
              "host": "auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    }
  }
}
